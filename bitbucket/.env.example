# Bitbucket MCP Server Environment Variables

# Bitbucket Authentication (API Token)
# Create API token at: https://bitbucket.org/account/settings/api-tokens/
BITBUCKET_EMAIL=your-atlassian-email@example.com
BITBUCKET_API_TOKEN=your-api-token

# Bitbucket Configuration (Optional)
BITBUCKET_WORKSPACE=your-default-workspace
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_TIMEOUT=30000

# Application Environment
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=error
LOGGING_ENABLED=true
LOG_FILE_ENABLED=true
LOG_MAX_FILE_SIZE=20m
LOG_MAX_FILES=14d
