# GitLab Configuration
# Your GitLab Personal Access Token
# Create at: https://gitlab.com/-/user_settings/personal_access_tokens
# Required scopes: api, read_api, read_repository, write_repository
GITLAB_TOKEN=your-personal-access-token-here

# GitLab API Base URL
# For GitLab.com use: https://gitlab.com/api/v4
# For self-hosted GitLab use: https://your-gitlab-instance.com/api/v4
GITLAB_BASE_URL=https://gitlab.com/api/v4

# Request timeout in milliseconds (default: 30000)
GITLAB_TIMEOUT=30000

# Logging Configuration
# Log level: error, warn, info, debug (default: error)
LOG_LEVEL=error

# Enable file logging (default: true)
LOG_FILE_ENABLED=true

# Maximum log file size (default: 20m)
LOG_MAX_FILE_SIZE=20m

# Maximum number of log files to keep (default: 14d for 14 days)
LOG_MAX_FILES=14d
